{
  // `next build` writes the static site to ./out (output: "export"), and
  // Cloudflare serves those files directly. Only /api/* runs the Worker in
  // worker/index.ts, which stores applications in D1.
  "name": "website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-applications",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 5 applications per minute from one IP address.
  "ratelimits": [
    {
      "name": "APPLY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
